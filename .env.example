# Set real values privately in Railway Variables; never commit secrets!
MASTER_CAD_PASSWORD=replace-with-a-long-private-password
FLASK_SECRET_KEY=replace-with-an-independent-strong-random-secret
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Optional CUDA workstation, NOT required on Railway right now.
# Do not enable until a working authenticated GPU worker and model adapter exist.
# MASTER_CAD_GPU_WORKER_URL=https://your-trusted-gpu-worker.example
# MASTER_CAD_GPU_WORKER_TOKEN=separate-long-random-token
